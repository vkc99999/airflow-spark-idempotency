@task(task_id="copy_unzip_to_dataset_landing")
def ${method}(**context):

    # MUST match the upstream sensor task_id that returns the found .gz key.
    # If your sensor task_id is different, change it here.
    source_gz_key = "{{ task_instance.xcom_pull(task_ids='s3_file_sensor_task', key='return_value') }}"

    target_prefix = "${target_location}"
    print(f"source_gz_key  : {str(source_gz_key)}")
    print(f"target_prefix  : {str(target_prefix)}")

    from packages.get_batch_number import S3_Object_Management

    return S3_Object_Management(${bucket_name}).move_gz_to_dataset_and_unzip(
        source_key=source_gz_key,
        target_prefix=target_prefix,
        delete_dataset_gz="Y"
    )


class S3_Object_Management:
    # ... your existing code ...

    def _multipart_upload_bytes(
        self,
        destination_key: str,
        byte_iter,
        content_type: str = "text/tab-separated-values",
        chunk_size: int = 8 * 1024 * 1024,  # 8MB (>= 5MB for multipart parts)
    ) -> Dict:
        """
        Streams bytes into S3 using multipart upload.
        Returns: {"bytes_written": int, "sha256": str}
        """
        upload_id = None
        parts: List[Dict] = []
        bytes_written = 0
        sha256 = hashlib.sha256()

        try:
            resp = self.s3_client.create_multipart_upload(
                Bucket=self.bucket,
                Key=destination_key,
                ContentType=content_type,
            )
            upload_id = resp["UploadId"]

            part_number = 1
            while True:
                chunk = next(byte_iter, None)
                if chunk is None:
                    break

                if not chunk:
                    continue

                sha256.update(chunk)
                bytes_written += len(chunk)

                up = self.s3_client.upload_part(
                    Bucket=self.bucket,
                    Key=destination_key,
                    PartNumber=part_number,
                    UploadId=upload_id,
                    Body=chunk,
                )
                parts.append({"ETag": up["ETag"], "PartNumber": part_number})
                part_number += 1

            if not parts:
                raise Exception("No data produced during gunzip (empty output)")

            self.s3_client.complete_multipart_upload(
                Bucket=self.bucket,
                Key=destination_key,
                UploadId=upload_id,
                MultipartUpload={"Parts": parts},
            )

            return {"bytes_written": bytes_written, "sha256": sha256.hexdigest()}

        except Exception:
            if upload_id:
                try:
                    self.s3_client.abort_multipart_upload(
                        Bucket=self.bucket,
                        Key=destination_key,
                        UploadId=upload_id,
                    )
                except Exception:
                    pass
            raise

    def move_gz_to_dataset_and_unzip(
        self,
        source_key: str,
        target_prefix: str,
        delete_dataset_gz: str = "Y",
    ) -> str:
        """
        Copies source .gz into target_prefix, gunzips to .tsv in target_prefix,
        validates gunzip via gzip CRC + output ContentLength, then deletes dataset .gz (optional).

        Returns: destination .tsv key (the unzipped key)
        """
        if not source_key or not target_prefix:
            raise Exception("source_key and target_prefix are required")

        # Normalize prefix
        if not target_prefix.endswith("/"):
            target_prefix = target_prefix + "/"

        base_name = source_key.split("/")[-1]
        if not base_name.endswith(".gz"):
            raise Exception(f"Expected .gz file but got: {base_name}")

        dataset_gz_key = target_prefix + base_name
        dataset_tsv_key = target_prefix + base_name[:-3]  # drop ".gz"

        print(f"Source gz           : {source_key}")
        print(f"Dataset gz copy     : {dataset_gz_key}")
        print(f"Dataset tsv (output): {dataset_tsv_key}")

        # 1) Copy gz -> dataset prefix (DON'T delete source yet; safer)
        copy_source = {"Bucket": self.bucket, "Key": source_key}
        self.s3_client.copy_object(
            CopySource=copy_source,
            Bucket=self.bucket,
            Key=dataset_gz_key,
        )

        # Validate copy of gz using your existing logic (size + ETag)
        validate_copy = self.validate_copy(source_key, dataset_gz_key)
        if validate_copy is None:
            raise Exception("GZ copy validation failed (size/etag mismatch)")

        # 2) Stream gunzip dataset_gz_key -> dataset_tsv_key
        #    gzip module validates CRC when it reaches EOF.
        obj = self.s3_client.get_object(Bucket=self.bucket, Key=dataset_gz_key)
        body = obj["Body"]

        def decompressed_chunks():
            gz = gzip.GzipFile(fileobj=body)
            try:
                while True:
                    chunk = gz.read(8 * 1024 * 1024)  # 8MB decompressed chunks
                    if not chunk:
                        break
                    yield chunk
            finally:
                # closing verifies CRC/trailer
                gz.close()
                body.close()

        upload_result = self._multipart_upload_bytes(
            destination_key=dataset_tsv_key,
            byte_iter=iter(decompressed_chunks()),
            content_type="text/tab-separated-values",
        )

        # 3) Validate output size == bytes written
        out_head = self.s3_client.head_object(Bucket=self.bucket, Key=dataset_tsv_key)
        out_size = out_head.get("ContentLength", 0)
        if out_size != upload_result["bytes_written"]:
            raise Exception(
                f"Unzip validation failed: "
                f"bytes_written={upload_result['bytes_written']} "
                f"but S3 ContentLength={out_size}"
            )

        print(f"Unzip OK. Output bytes={out_size}, sha256={upload_result['sha256']}")

        # 4) Now that we have a valid .tsv, delete original source gz
        #    (prevents reprocessing in /current/)
        self.s3_client.delete_object(Bucket=self.bucket, Key=source_key)
        print(f"Deleted source gz: {source_key}")

        # 5) Optionally delete the dataset gz copy (since .tsv is the real input)
        if str(delete_dataset_gz).upper() == "Y":
            self.s3_client.delete_object(Bucket=self.bucket, Key=dataset_gz_key)
            print(f"Deleted dataset gz copy: {dataset_gz_key}")

        return dataset_tsv_key


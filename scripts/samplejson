@task(task_id='get_s3_file')
def ${method}(**context):

    import boto3
    import gzip
    from airflow.exceptions import AirflowFailException

    ti = context["task_instance"]

    sensor_task_id = "${sensor_task_id}".strip()
    if not sensor_task_id:
        raise AirflowFailException("sensor_task_id is required")

    src_key = ti.xcom_pull(task_ids=sensor_task_id)
    if not src_key:
        raise AirflowFailException(f"No key found from sensor task_id={sensor_task_id}")

    bucket = "${bucket_name}"
    target_prefix = "${target_location}".rstrip("/") + "/"

    filename = src_key.split("/")[-1]

    unzip_mode = "${unzip_mode}".strip().upper()  # AUTO | Y | N
    if unzip_mode not in ("AUTO", "Y", "N"):
        unzip_mode = "AUTO"

    should_unzip = (unzip_mode == "Y") or (unzip_mode == "AUTO" and filename.endswith(".gz"))

    if should_unzip and filename.endswith(".gz"):
        out_filename = filename[:-3]   # drop .gz
    else:
        out_filename = filename

    dest_key = target_prefix + out_filename

    s3 = boto3.client("s3")

    # MOVE + (optional) UNZIP
    if should_unzip:
        obj = s3.get_object(Bucket=bucket, Key=src_key)
        body = obj["Body"]  # StreamingBody
        with gzip.GzipFile(fileobj=body) as gz:
            s3.upload_fileobj(gz, bucket, dest_key)
    else:
        s3.copy_object(
            CopySource={"Bucket": bucket, "Key": src_key},
            Bucket=bucket,
            Key=dest_key
        )

    # delete source so it doesn't get picked up again
    s3.delete_object(Bucket=bucket, Key=src_key)

    print(f"Moved {'and unzipped ' if should_unzip else ''}{src_key} -> {dest_key}")

    # archive templates will read this
    return dest_key
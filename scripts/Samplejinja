def _pick_oldest_ts_prefer_full_then_smallest_part(
    self,
    keys: List[str],
    file_prefix: str,
) -> str:
    """Oldest timestamp date; prefer Full on that date; else oldest ts; always smallest part."""
    candidates: List[Tuple[str, str, int, str]] = []

    for k in keys:
        fn = k.split("/")[-1]
        if not fn.endswith(".tsv.gz"):
            continue

        meta = self._parse_ts_type_part(fn, file_prefix)
        if not meta:
            continue

        ts, ftype, part = meta
        candidates.append((ts, ftype, part, k))

    if not candidates:
        raise Exception(f"No matching .tsv.gz keys for prefix={file_prefix}")

    oldest_ts = min(ts for (ts, _, _, _) in candidates)
    oldest_date = oldest_ts[:8]

    same_date = [c for c in candidates if c[0].startswith(oldest_date)]
    fulls = [c for c in same_date if c[1] == "Full"]

    if fulls:
        _, _, _, selected = min(fulls, key=lambda x: (x[0], x[2]))
        return selected

    _, _, _, selected = min(candidates, key=lambda x: (x[0], x[2]))
    return selected
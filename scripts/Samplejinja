def _parse_ts_type_part(
    self,
    filename: str,
    file_prefix: str,
) -> Optional[Tuple[str, str, int]]:
    """Parse '<prefix>-<14ts>-<Full|Incremental>-<part>.tsv.gz' -> (ts, type, part)."""
    rx = re.compile(
        rf"^{re.escape(file_prefix)}-(\d{{14}})-(Full|Incremental)-(\d+)\.tsv\.gz$"
    )
    m = rx.match(filename)
    if not m:
        return None
    return m.group(1), m.group(2), int(m.group(3))


def _pick_oldest_ts_prefer_full_then_smallest_part(
    self,
    keys: List[str],
    file_prefix: str,
) -> str:
    """Pick oldest ts; within ts prefer Full; then smallest part."""
    candidates: List[Tuple[str, int, int, str]] = []

    for k in keys:
        fn = k.split("/")[-1]
        if not fn.endswith(".tsv.gz"):
            continue

        meta = self._parse_ts_type_part(fn, file_prefix)
        if not meta:
            continue

        ts, ftype, part = meta
        type_rank = 0 if ftype == "Full" else 1
        candidates.append((ts, type_rank, part, k))

    if not candidates:
        raise Exception(f"No matching .tsv.gz keys for prefix={file_prefix}")

    candidates.sort()
    return candidates[0][3]
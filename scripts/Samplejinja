import fnmatch

SEARCH_PREFIX = "${search_prefix}".rstrip("/") + "/"
FILE_PATTERNS = ${file_patterns}

def check_for_any_match(files, **kwargs):
    for f in files:
        key = f.get("Key", "") if isinstance(f, dict) else str(f)
        file_name = key.split("/")[-1]

        if any(fnmatch.fnmatch(file_name, pattern) for pattern in FILE_PATTERNS):
            return True

    return False

${method} = S3KeySensor(
    task_id="${method}",
    bucket_key=f"{SEARCH_PREFIX}*",
    wildcard_match=True,
    bucket_name=${bucket_name},
    check_fn=check_for_any_match,
    poke_interval=${poke_interval},
    timeout=${timeout},
    mode="reschedule",
    soft_fail=True,
    deferrable=False
)

{
  "task-group-name": "FILE_WATCHER_SOURCE",
  "dependency-group-name": "",
  "type": "TASK",
  "task-object-type": "operator",
  "task-details": [
    {
      "task-template-name": "s3_anykey_sensor",
      "input-params-in-order": {
        "method": "wait_for_source_files",
        "search_prefix": "landing/source/current/",
        "file_patterns": [
          "ConfigurationFact*.tsv.gz",
          "CrossWalkDimension*.tsv.gz",
          "CompositeDimension*.tsv.gz",
          "FeeTable*.tsv.gz",
          "PricerDimension*.tsv.gz",
